Algoritmo transferenciaAB
	//Tarea 1- yo
	Definir letraCuenta Como Caracter
	Definir A, B, C Como Entero
	Escribir "Objetivo: Transferir dinero de un punto A a un punto B"
	Escribir "Saldo Disponible en cuenta A"
	Leer saldo
	Escribir "Ingrese Monto a Transferir"
	Leer montoTransferir
	Escribir "Ingrese una cuenta a la que será transferida (A, B o C)"
	Leer letraCuenta
	transferencia = saldo - montoTransferir
	Escribir "Usted ha transferido ", transferencia, " Exitosamente hacia " B "."
FinAlgoritmo
