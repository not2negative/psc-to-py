Algoritmo ejercicio9
	// Problema: Área y Perímetro de un Terreno
	// Variables
	Definir ancho, largo, perimetro, area Como Real
	// Entrada
	Escribir "Ingrese el ancho del terreno (en metros):"
	Leer ancho
	Escribir "Ingrese el largo del terreno (en metros):"
	Leer largo
	// Procesamiento
	perimetro = 2 * (ancho + largo)
	area = ancho * largo
	// Salida
	Escribir "El área total del terreno es de: ", area, "m², y el perímetro total es de: ", perimetro, "m."
FinAlgoritmo
