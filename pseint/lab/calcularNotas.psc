Algoritmo calcularNotas
	// Contexto: Calcular el promedio para 3 notas, donde cada una de ellas tiene el mismo porcentaje.
	// Declaraci�n de variables
	Definir nota_1, nota_2, nota_3, nota_final Como Real
	// Entrada
	Escribir "Ingrese la primera nota:"
	Leer nota_1
	Escribir "Ingrese la primera nota:"
	Leer nota_2
	Escribir "Ingrese la primera nota:"
	Leer nota_3
	// Procesamiento
	nota_final = (nota_1 + nota_2 + nota_3) / 3
	// Salida
	Escribir "Tu nota final es de: ", nota_final, "."
FinAlgoritmo
