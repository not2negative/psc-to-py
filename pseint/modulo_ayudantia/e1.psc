Algoritmo transferenciaDeAaB
	//Tarea 1 - Profesor
	Definir A, B, C Como Entero
	Escribir "Ingresa el saldo de la cuenta A"
	Leer A
	Escribir "Ingresa el monto a transferir a la cuenta B"
	Leer C
	C = A - B
	B = C
	Escribir "Has transferido exitosamente $", C, " a la cuenta B."
FinAlgoritmo
